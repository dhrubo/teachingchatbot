# EditorConfig — https://editorconfig.org
# Aligned with biome.jsonc (2-space indent) so non-Biome editors match on save.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown uses trailing whitespace for hard line breaks.
[*.md]
trim_trailing_whitespace = false

# Match common lockfile / generated formatting.
[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
