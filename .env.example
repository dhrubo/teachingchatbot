# ──────────────────────────────────────────────
# Required (pick at least one AI provider)
# ──────────────────────────────────────────────

# Google Gemini (recommended — free tier, no credit card)
# https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# Premium Gemini key — used for signed-in users (regular + admin) instead of
# the free key above. Leave unset to use the same key for everyone.
# GOOGLE_GENERATIVE_AI_API_KEY_PREMIUM=your_premium_key_here

# Gemini model to use (default: gemini-3.1-flash-lite)
# GOOGLE_GENERATIVE_AI_MODEL=gemini-3.1-flash-lite

# ──────────────────────────────────────────────
# Optional Free-Tier Fallback Providers
# ──────────────────────────────────────────────

# Groq (fast open-source models, free tier)
# https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (access to many free models)
# https://openrouter.ai/settings/keys
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# OpenAI (optional, direct — no free tier; requires a positive account
# balance). Both vars are required: the app does NOT hardcode a default
# OpenAI model, since complimentary/free-token eligibility is an
# account-level OpenAI decision, not something to bake into app code. See
# docs/providers.md for details (data-sharing opt-out, tool-use exclusion).
# https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4o-mini

# Comma-separated provider ids (stable, not display names) controlling
# fallback order, e.g.: openai,gemini-free,groq,openrouter
# AI_PROVIDER_ORDER=

# ──────────────────────────────────────────────
# Voice (optional — tap-to-speak, off by default)
# ──────────────────────────────────────────────

# Master switch — voice routes/UI stay disabled until this is set, even if
# GROQ_API_KEY is present (see docs/privacy.md's Voice section).
# VOICE_ENABLED=1

# Speech-to-text uses the Groq key/config above (GROQ_API_KEY). Model id for
# transcription specifically (default: whisper-large-v3-turbo).
# GROQ_STT_MODEL=whisper-large-v3-turbo

# Text-to-speech uses the browser's native speechSynthesis for the MVP — no
# additional provider or key needed.

# Voice session + audio limits (sensible defaults shown; override if needed).
# VOICE_SESSION_TTL_MINUTES=30
# VOICE_MAX_AUDIO_DURATION_MS=30000
# VOICE_MAX_AUDIO_FILE_BYTES=5242880
# VOICE_SILENCE_STOP_MS=1200
# VOICE_MINIMUM_SPEECH_MS=250
# VOICE_REQUESTS_PER_HOUR=60

# ──────────────────────────────────────────────
# Optional: Vercel AI Gateway (advanced)
# ──────────────────────────────────────────────

# Enable only if you have a Vercel account with AI Gateway access
# USE_VERCEL_AI_GATEWAY=1
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=google/gemini-3.1-flash-lite

# ──────────────────────────────────────────────
# Database (required)
# ──────────────────────────────────────────────

# Neon Postgres (free tier: https://neon.tech)
# POSTGRES_URL=your_neon_database_url_here

# ──────────────────────────────────────────────
# Auth (required)
# ──────────────────────────────────────────────

# Generate: `openssl rand -base64 32` or https://generate-secret.vercel.app/32
# AUTH_SECRET=your_random_secret_here

# ──────────────────────────────────────────────
# Optional Storage & Cron
# ──────────────────────────────────────────────

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/redis
REDIS_URL=****

# Secret for guest cleanup cron (generate with `openssl rand -base64 32`)
CRON_SECRET=****

# ──────────────────────────────────────────────
# LLM Call Optimisation
# ──────────────────────────────────────────────

# By default, chat titles are deterministic (no LLM call).
# Set to 1 to use the LLM for generating chat titles.
# ENABLE_LLM_TITLE_GENERATION=0

# ──────────────────────────────────────────────
# Mode & Limits
# ──────────────────────────────────────────────

# APP_MODE=FREE (default) — guests see 5 questions/day, 24h retention, no history.
# APP_MODE=PREMIUM — gates future features (admin dashboards, approval workflows).
# Note: APP_MODE does NOT affect the AI provider. Use GOOGLE_GENERATIVE_AI_API_KEY
# vs GOOGLE_GENERATIVE_AI_API_KEY_PREMIUM to route different keys by user type.
APP_MODE=FREE

# How long guest chat history is kept before auto-cleanup (hours).
FREE_CHAT_RETENTION_HOURS=24

# Maximum questions a guest can answer per day.
GUEST_DAILY_QUESTION_LIMIT=5

# Optional: webhook URL (Slack/Discord/Zapier incoming webhook) notified when a
# student requests a topic that isn't in the curriculum yet. Leave unset to
# disable notifications (requests are still logged to the TopicRequest table).
# TOPIC_REQUEST_WEBHOOK_URL=https://hooks.slack.com/services/...

# ──────────────────────────────────────────────
# Privacy (see docs/privacy.md)
# ──────────────────────────────────────────────

# Required only if you use lib/privacy/redact.ts's pseudonymousId() — e.g. for
# a future shareable analytics export. Not needed for normal app operation.
# ANALYTICS_HASH_SECRET=generate_a_long_random_string_here

# Optional: webhook URL (Slack/Discord/Zapier incoming webhook — same style as
# TOPIC_REQUEST_WEBHOOK_URL above) notified when a tutor reply's unsafe_content
# violation survives the one repair attempt and falls back to the safe
# canned text. See docs/privacy.md's moderation/escalation section for the
# exact, honestly-scoped trigger condition. Leave unset to disable (no-op).
# GUARDIAN_ESCALATION_WEBHOOK_URL=https://hooks.slack.com/services/...

# ──────────────────────────────────────────────
# MCP Tooling (developer-only — not used at runtime)
# ──────────────────────────────────────────────

# Consumed by the GitHub MCP server (opencode.json / .mcp.json) for repo,
# issue, and PR access. Create a fine-grained token at
# https://github.com/settings/tokens. Only needed if you use the GitHub MCP.
# GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_here

# The PostgreSQL MCP server reuses POSTGRES_URL (defined above) for read-only
# schema/query introspection. No additional variable is required.
