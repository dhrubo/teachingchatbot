# ──────────────────────────────────────────────────────────────────────
# Mr. Ranedeer Voice Tutor — Edexcel GCSE Maths (1MA1)
# All recommended providers below have 100% FREE tiers (no card needed).
# ──────────────────────────────────────────────────────────────────────

# 1. GroqCloud (Recommended Primary — Free Tier: https://console.groq.com/keys)
# Powers sub-200ms Whisper voice transcription AND ultra-fast Socratic turns.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# 2. Google AI Studio (Recommended Co-Primary / Fallback — Free Tier: https://aistudio.google.com/apikey)
# Powers structured visual maths explanations & absorbs quota bursts.
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=gemini-3.1-flash-lite

# 3. OpenRouter (Optional 3rd Free Fallback — https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# Optional comma-separated provider priority override (default: groq,gemini-free,openrouter)
AI_PROVIDER_ORDER=groq,gemini-free,openrouter

# ──────────────────────────────────────────────────────────────────────
# Tutor Voice Output (TTS — $0 Free British Neural Voice)
# ──────────────────────────────────────────────────────────────────────
# Default voice for Edge Neural TTS (falls back automatically to browser en-GB speechSynthesis)
TTS_VOICE=en-GB-SoniaNeural

# ──────────────────────────────────────────────────────────────────────
# Duolingo-Style Daily Practice Reminders (100% Free Web Push VAPID)
# Generate keys anytime with: `pnpm vapid:generate`
# (In local dev, temporary VAPID keys are auto-generated if left blank!)
# ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tutor@example.com

# Secret token guarding GET/POST /api/cron/daily-reminders in production
CRON_SECRET=

# ──────────────────────────────────────────────────────────────────────
# Database (Optional locally — Required on Vercel for persistent streaks/push)
# Free serverless Postgres: https://neon.tech
# When unset locally, the app automatically persists to `.data/local-store.json`.
# ──────────────────────────────────────────────────────────────────────
POSTGRES_URL=

# ──────────────────────────────────────────────────────────────────────
# Authentication (Parent/Guardian Watcher & Student / Kid PIN Sessions)
# Generate with: `openssl rand -base64 32` (uses a safe local fallback in dev)
# ──────────────────────────────────────────────────────────────────────
AUTH_SECRET=
